# Optional overrides.

# Upstream origin. Leave unset unless you are pointing at a test lane.
# DEEPAI_BASE=https://api.deepai.org

# Where the bridge listens. Keep it on loopback.
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8788

# Appended to model IDs the way OpenCode sees them. Empty by default, so the
# exposed id is exactly the upstream id (deepai/glm-5.3-flash).
# MODEL_SUFFIX=

# Only needed if you skip `npm run auth` and paste a key by hand.
# DEEPAI_API_KEY=

# Override the derived machine digest (hex sha256) if auto-detection fails.
# DEEPAI_MACHINE_ID=

# Override the beacon version normally read from the installed desktop build.
# DEEPAI_APP_VERSION=

# Where the signed-in key is stored. Defaults to
# %LOCALAPPDATA%\deepai-bridge\secrets.json (outside this folder on purpose).
# DEEPAI_SECRETS=
